{
  "name": "logbook",
  "version": "1.0.1",
  "private": true,
  "description": "No training set? Let behaviour build one.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:live": "LOGBOOK_LIVE=1 vitest run test/ollama.live.test.ts",
    "typecheck": "tsc --noEmit",
    "synth": "tsx scripts/synth.ts",
    "materialise": "tsx scripts/materialise.ts",
    "pairs": "tsx scripts/records-to-pairs.ts",
    "reliability": "tsx scripts/reliability.ts",
    "example": "tsx examples/local-model/server.ts",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts && mkdir -p out/demo/schema/0.1 && cp schema/*.json out/demo/schema/0.1/"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
