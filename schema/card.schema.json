{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carlholland93.github.io/logbook/schema/0.1/card.schema.json",
  "title": "Card",
  "description": "What the model hands the UI for one decision. Five primitives in a fixed render order (signal, evidence, ask, choice, check_in). The model may omit `ask`. It may never add, rename or reorder primitives. If the model's output does not validate, the UI renders a `prose` card instead.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "card_id", "kind"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "card_id": { "type": "string", "minLength": 8, "description": "Opaque id, generated by the adapter, not the model." },
    "kind": { "enum": ["decision", "prose"] },

    "prose": {
      "type": "object",
      "description": "Fallback primitive. Present only when kind = prose.",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "maxLength": 1200 },
        "reason": { "enum": ["invalid_json", "schema_violation", "model_declined", "adapter_error"] }
      }
    },

    "signal": {
      "type": "object",
      "description": "1. What the model thinks. Rendered as a headline and a confidence band, never a point.",
      "additionalProperties": false,
      "required": ["headline", "level", "confidence"],
      "properties": {
        "headline": { "type": "string", "maxLength": 120 },
        "level": { "enum": ["low", "medium", "high"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "Raw, model-declared. Logged as a float so it can be calibrated later." }
      }
    },

    "evidence": {
      "type": "array",
      "description": "2. What the signal rests on. Every line carries its basis.",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "basis"],
        "properties": {
          "text": { "type": "string", "maxLength": 160 },
          "basis": { "enum": ["data", "rule_of_thumb", "you", "unknown"] },
          "ref": { "type": "string", "description": "Id of the input item this line cites. Required by the semantic check when basis = data." }
        }
      }
    },

    "ask": {
      "type": "object",
      "description": "3. What the model needs from the person. Optional: omit when there is nothing to ask. Also reused by the UI to collect an override reason.",
      "additionalProperties": false,
      "required": ["question", "kind"],
      "properties": {
        "question": { "type": "string", "maxLength": 120 },
        "kind": { "enum": ["text", "chips"] },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" },
              "label": { "type": "string", "maxLength": 40 }
            }
          }
        }
      },
      "if": { "properties": { "kind": { "const": "chips" } } },
      "then": { "required": ["question", "kind", "options"] }
    },

    "choice": {
      "type": "object",
      "description": "4. The call. Two to four options, at most one recommended. The UI may withhold the highlight (see record.shown.highlight_shown).",
      "additionalProperties": false,
      "required": ["options"],
      "properties": {
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" },
              "label": { "type": "string", "maxLength": 40 },
              "rationale": { "type": "string", "maxLength": 120 }
            }
          }
        },
        "recommended": { "type": ["string", "null"], "description": "Id of the recommended option, or null if the model has no recommendation. Membership in `options` is checked by validate.ts: JSON Schema cannot compare one field to another." }
      }
    },

    "check_in": {
      "type": "object",
      "description": "5. The follow-up that closes the record. Delivered after `due_in`. The UI always appends a `cant_tell` option. `confirms` names the option that means the signal turned out right, so the log can score confidence against what happened.",
      "additionalProperties": false,
      "required": ["question", "due_in", "options", "confirms"],
      "properties": {
        "question": { "type": "string", "maxLength": 120 },
        "due_in": { "type": "string", "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$", "description": "ISO 8601 duration from the moment the choice is made, e.g. P3D." },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" },
              "label": { "type": "string", "maxLength": 40 }
            }
          }
        },
        "confirms": { "type": "string", "description": "Id of the check-in option that means the signal came true. Must be one of `options`; checked by validate.ts." }
      }
    }
  },

  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "decision" } } },
      "then": {
        "required": ["schema_version", "card_id", "kind", "signal", "evidence", "choice", "check_in"],
        "not": { "required": ["prose"] }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "prose" } } },
      "then": {
        "required": ["schema_version", "card_id", "kind", "prose"],
        "not": { "anyOf": [ { "required": ["signal"] }, { "required": ["evidence"] }, { "required": ["ask"] }, { "required": ["choice"] }, { "required": ["check_in"] } ] }
      }
    }
  ]
}
